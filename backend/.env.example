# Local development defaults
HOST=127.0.0.1
PORT=8080

# PostgreSQL connection string. Keep the real value in deployment secrets only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set PGSSL=true only when the database provider requires verified TLS.
PGSSL=false

# Comma-separated exact browser origins. Leave empty until a trusted client origin is known.
ALLOWED_ORIGINS=
